// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum GoalType {
  INDIVIDUAL
  TEAM
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
}

enum QuestionType {
  TEXT
  SCALE
  BOOLEAN
}

enum ActionItemStatus {
  OPEN
  DONE
}

// --- Auth.js required models (Prisma adapter) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Core domain ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)
  title         String?
  department    String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  managerId String?
  manager   User?   @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("ManagerReports")

  accounts Account[]
  sessions Session[]

  checkIns       CheckIn[]    @relation("CheckInAuthor")
  goalsOwned     Goal[]       @relation("GoalOwner")
  goalUpdates    GoalUpdate[]
  oneOnOnesAsMgr OneOnOne[]   @relation("OneOnOneManager")
  oneOnOnesAsRep OneOnOne[]   @relation("OneOnOneReport")
  actionItems    ActionItem[] @relation("ActionItemAssignee")

  @@index([managerId])
}

// Configurable question set, versioned so historical responses stay meaningful
// even if the template changes later.
model CheckInTemplate {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  questions CheckInQuestion[]
  checkIns  CheckIn[]
}

model CheckInQuestion {
  id         String          @id @default(cuid())
  templateId String
  template   CheckInTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  prompt     String
  type       QuestionType
  order      Int
  isRequired Boolean         @default(true)

  responses CheckInResponse[]

  @@index([templateId])
}

model CheckIn {
  id         String          @id @default(cuid())
  authorId   String
  author     User            @relation("CheckInAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  templateId String
  template   CheckInTemplate @relation(fields: [templateId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  moodScore   Int?
  energyScore Int?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  responses   CheckInResponse[]
  goalUpdates GoalUpdate[]

  @@unique([authorId, periodStart])
  @@index([authorId, periodStart])
}

model CheckInResponse {
  id         String          @id @default(cuid())
  checkInId  String
  checkIn    CheckIn         @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  questionId String
  question   CheckInQuestion @relation(fields: [questionId], references: [id])
  textValue  String?         @db.Text
  scaleValue Int?

  @@unique([checkInId, questionId])
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  type        GoalType
  status      GoalStatus @default(NOT_STARTED)
  ownerId     String
  owner       User       @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  progress    Int        @default(0)
  startDate   DateTime
  targetDate  DateTime
  createdAt   DateTime   @default(now())

  updates GoalUpdate[]

  @@index([ownerId])
}

model GoalUpdate {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  checkInId String?
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  progress  Int
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([goalId])
}

model OneOnOne {
  id          String   @id @default(cuid())
  managerId   String
  manager     User     @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)
  reportId    String
  report      User     @relation("OneOnOneReport", fields: [reportId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  agenda      String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  actionItems ActionItem[]

  @@index([managerId])
  @@index([reportId])
}

model ActionItem {
  id          String           @id @default(cuid())
  oneOnOneId  String
  oneOnOne    OneOnOne         @relation(fields: [oneOnOneId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User             @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  description String
  status      ActionItemStatus @default(OPEN)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())

  @@index([oneOnOneId])
}
